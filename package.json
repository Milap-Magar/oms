{
  "name": "ordiva-frontend",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot ./server.ts",
    "start": "NODE_ENV=production bun ./server.ts",
    "build": "bun build ./index.html --outdir ./dist --production",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
